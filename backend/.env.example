# Servidor Express (Render asigna PORT automáticamente en producción)
PORT=3000
NODE_ENV=development

# Dominio público del frontend (Firebase Hosting, soporta múltiples URLs separadas por coma)
FRONTEND_URL=https://tu-proyecto.web.app

# Conexión a Base de Datos MySQL en local o en la nube (Aiven / TiDB / PlanetScale)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=candy_boom_db
# Usar true cuando el proveedor MySQL en la nube requiera SSL (ej. Aiven, TiDB)
DB_SSL=false

# Claves de Autenticación JWT y Cookies
JWT_SECRET=cambia_esta_clave_secreta_jwt_en_produccion
JWT_EXPIRES_IN=24h
COOKIE_SECRET=cambia_esta_clave_secreta_cookie_en_produccion
